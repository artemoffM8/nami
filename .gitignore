# --- Артефакты сборки ---
# 961 МБ на трёх пакетах. Полностью воспроизводится из исходников.
.build/
DerivedData/
# Без слэша внутри шаблона — иначе он привязывается к корню репозитория и
# не ловит те же папки внутри пакетов. Именно так в первый коммит попало
# имя пользователя в путях Packages/*/.swiftpm/xcode/xcuserdata/.
xcuserdata/
.swiftpm/
*.xcuserstate
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# --- macOS ---
.DS_Store

# --- Исходный звук до сжатия ---
# 55 МБ WAV. Уже лежат в App/Resources/Sounds как CAF/ALAC — сжатие без
# потерь, PCM совпадает побайтово, так что исходники восстанавливаются из
# репозитория одной командой ffmpeg. Держать обе копии незачем.
kits/

# --- Личные документы ---
# В docs/ лежат PDF, не относящиеся к проекту. Держим их вне истории:
# из публичного репозитория такое уже не убрать — git помнит всё.
docs/*.pdf
_to_delete/
